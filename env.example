# Market Trace V6.0 — 环境变量模板
# 复制此文件为 env 并填入真实值，env 不会被提交到 Git
# cp env.example env

# --- AI 多级回退链 API Keys ---

# 主力模型：DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 备用模型：Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# 三级备选：Google Gemini (Key2，防限频)
GEMINI_API_KEY_2=your-gemini-api-key-2

# 四级兜底/五级兜底：智谱 GLM (同一 Key，不同模型)
ZHIPU_API_KEY=your-zhipu-api-key

# 六级兜底：硅基流动 (SiliconFlow)
SILICONFLOW_API_KEY=your-siliconflow-api-key

# 七级兜底：百度千帆
QIANFAN_API_KEY=your-qianfan-api-key

# --- 可选数据源 Token ---
TUSHARE_TOKEN=your-tushare-token

# --- API 访问令牌（未配置时所有端点无认证）---
API_TOKEN=your-random-api-token

# --- Go Edition 运行参数 ---
PORT=19377
MT6_DATA_DIR=data/go
MT6_HTTPS=false
MT6_REQUEST_TIMEOUT=12s
SESSION_TTL=168h
ALLOW_REGISTRATION=true

# --- 交易通道 ---
# paper=内置模拟盘；live 仍需下方官方券商网关与 ALLOW_LIVE_TRADING=true
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
ALLOW_LIVE_CUSTODY=false
# BROKER_GATEWAY_URL=https://your-broker-bridge:9443
# BROKER_GATEWAY_KEY_ID=
# BROKER_GATEWAY_SECRET=
# BROKER_ACCOUNT_ID=
# 仅在可信内网使用明文 HTTP 时开启
# BROKER_GATEWAY_ALLOW_HTTP=false

# --- Redis 密码（留空则无密码）---
REDIS_PASSWORD=

# --- 微信通知 (WxPusher: https://wxpusher.zjiecode.com) ---
WXPUSHER_TOKEN=your-wxpusher-token
WXPUSHER_UID=your-wxpusher-uid

# --- HTTP 代理（访问国内数据源时使用）---
# HTTP_PROXY=http://your-proxy-ip:7890
# HTTPS_PROXY=http://your-proxy-ip:7890
